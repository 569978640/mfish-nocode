# 部署环境变量模板
# 复制为 .env 并按实际填写：cp .env.deploy.example .env

# 现成 Nacos 连接信息（注册中心 + 配置中心）
NACOS_ADDR=10.0.0.10:8848
NACOS_USER=nacos
NACOS_PASS=nacos

# Nacos 配置集对应的 profile（配置 dataId 形如 mf-oauth-dev.yml 时填 dev）
NACOS_PROFILE=dev

# 四个服务统一的 JVM 参数
JVM_OPTS=-Xms512m -Xmx1024m

# 镜像标签（与打包时保持一致，默认 2.4.1）
MF_IMAGE_TAG=2.4.1
